{
  "name": "app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev:api": "TZ=utc APP_NAME='api' nest start -b swc -w",
    "start:dev:tg-bot": "TZ=utc APP_NAME='tg-bot' nest start -b swc -w",
    "start:dev:worker": "TZ=utc APP_NAME='worker' nest start -b swc -w",
    "start:dev:job-worker": "TZ=utc APP_NAME='job-worker' nest start -b swc -w",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "fmt": "pnpm exec biome format --write",
    "ci:check-routing": "tsx src/scripts/validate-routing-prefixes.ts",
    "ci:s:c": "pnpm exec biome check --write && pnpm run lint:types && pnpm run ci:check-routing",
    "ci:check": "pnpm exec biome check --write --unsafe && pnpm run lint:types && pnpm run ci:check-routing",
    "biome:check": "pnpm exec biome ci",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --config vitest.config.ts",
    "test:integration": "vitest --config vites.integration.config.ts",
    "test:e2e": "vitest --config vites.e2e.config.ts",
    "db:dev:push": "drizzle-kit push",
    "db:create": "drizzle-kit generate --custom",
    "db:generate": "NODE_OPTIONS='--import tsx' drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:drop": "npx tsx src/scripts/db/drop.ts",
    "db:seed": "tsx src/scripts/seed-test-data.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/session": "^11.1.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.10",
    "@nestjs/core": "^11.1.10",
    "@nestjs/microservices": "11.1.10",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.10",
    "@nestjs/typeorm": "^11.0.0",
    "@ton/core": "^0.63.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.1.0",
    "@tonconnect/sdk": "^3.4.0",
    "@types/luxon": "^3.4.2",
    "bignumber.js": "^9.1.2",
    "bip39": "^3.1.0",
    "bullmq": "^5.69.2",
    "cache-manager": "^5.3.2",
    "cron": "3.3.2",
    "deepmerge": "4.3.1",
    "dotenv": "16.3.1",
    "drizzle-orm": "1.0.0-beta.11-05230d9",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^5.8.0",
    "fastify": "5.6.2",
    "fastify-multer": "2.0.3",
    "fastify-raw-body": "^5.0.0",
    "grammy": "^1.38.4",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "js-yaml": "4.1.0",
    "luxon": "^3.5.0",
    "nestjs-pino": "^4.5.0",
    "neverthrow": "^8.2.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "redis-lru": "^0.6.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typebox": "^1.0.79",
    "undici": "^7.15.0",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^11.1.10",
    "@ngneat/falso": "^7.2.0",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.26",
    "@testcontainers/postgresql": "^11.0.4",
    "@types/express": "^4.17.17",
    "@types/js-yaml": "4.0.5",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.16.0",
    "@types/sinon": "17.0.3",
    "@types/ws": "^8.18.1",
    "cli^11.0.0": "link:@nestjs/cli^11.0.0",
    "drizzle-kit": "1.0.0-beta.11-05230d9",
    "fast-check": "^3.20.0",
    "msw": "^2.3.4",
    "pactum": "^3.7.0",
    "pactum-matchers": "^1.1.7",
    "sinon": "18.0.0",
    "source-map-support": "^0.5.21",
    "testcontainers": "^11.0.4",
    "ts-brand": "^0.1.0",
    "ts-loader": "^9.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.16"
  }
}
